rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Reglas de chats y mensajes (Integrante B). Las de users/{uid} las agrega el Integrante A.
    // Solo los dos participantes (los uid dentro del chatId) leen y escriben.
    match /chats/{chatId} {
      allow read, write: if request.auth != null
        && request.auth.uid in chatId.split('_');
      match /messages/{msgId} {
        allow read, write: if request.auth != null
          && request.auth.uid in chatId.split('_');
      }
    }
  }
}
