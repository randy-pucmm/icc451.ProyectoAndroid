rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // Perfiles (Integrante A): cualquier usuario autenticado puede verlos;
    // cada uno solo escribe el suyo.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Chats (Integrante B): solo los dos participantes, cuyos uid forman el chatId.
    // Boceto del documento de division de trabajo, sin probar contra la app:
    // revisar con el Rules Playground antes de publicar.
    match /chats/{chatId} {
      allow read, write: if request.auth != null
        && request.auth.uid in chatId.split('_');
      match /messages/{msgId} {
        allow read, write: if request.auth != null
          && request.auth.uid in chatId.split('_');
      }
    }
  }
}
